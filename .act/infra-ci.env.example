# Copy this file to .act/infra-ci.env.local and fill in local AWS credentials
# when running aws-actions/configure-aws-credentials under act.
# For temporary credentials, include AWS_SESSION_TOKEN as well.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
